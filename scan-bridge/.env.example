# Perinexa scan bridge – copy this file to scan-bridge/.env on the hospital PC and fill it in (never commit .env).

# Perinexa's address: https://… on the live server; http://localhost:4000 only when Perinexa runs on this same PC.
PERINEXA_URL=https://perinexa.example.in
# The key from Perinexa → Hospital admin → Ultrasound machine → Make a new key. A secret: anyone with it can send
# studies to the hospital. Make a new one if it is ever shared by mistake (the old one stops working).
BRIDGE_KEY=

# Orthanc on this PC (its REST port, 8042 by default) and the user in orthanc.json "RegisteredUsers".
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USER=bridge
ORTHANC_PASSWORD=

# The machine's worklist: the folder Orthanc's worklist plugin reads (orthanc.json "Worklists" → "Database").
# Leave empty if the machine has no worklist (DICOM Modality Worklist): staff then type the patient number on it.
WORKLIST_DIR=C:\PerinexaBridge\worklists
# The machine's AE title, if more than one machine reads the worklist and each should see only its own patients.
MACHINE_AET=

# How often to check Orthanc for new studies (seconds) and refresh the worklist (minutes).
POLL_SECONDS=10
WORKLIST_MINUTES=2

# Days a study stays in Orthanc on this PC before the bridge deletes it (Perinexa keeps what the sonologist used).
ORTHANC_KEEP_DAYS=30
