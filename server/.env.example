# Copy this file to server/.env and replace the placeholder values.
# NEVER commit server/.env to git (it is already listed in .gitignore).

NODE_ENV=development
API_PORT=4000

# Local database (only reachable from this computer). Use fake/sample data only.
MONGO_URI=mongodb://127.0.0.1:27017/perinexa

# The secret key that signs login sessions (JWT_SECRET) is made automatically on the first start and added at the
# end of server/.env – never written in the code. On a production server set your own long random value, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# The address of the website (only this address may call the API).
CLIENT_URL=http://localhost:5173

# Log out after this many minutes without activity.
SESSION_TIMEOUT_MINUTES=30

# Max login attempts per 15 minutes from one computer.
LOGIN_RATE_LIMIT_MAX=10

# The hospital's time zone. "Today" for care plans and weeks of pregnancy is the date in this time zone.
HOSPITAL_TIME_ZONE=Asia/Kolkata

# How many seconds a doctor's Analytics page is kept in memory before it is worked out again (0 = never kept).
# ANALYTICS_CACHE_SECONDS=60

# How many seconds the super admin's Analytics pages are kept in memory (0 = never kept).
# ANALYTICS_PLATFORM_CACHE_SECONDS=300

# "Secure" cookies only travel over HTTPS. Leave unset: it is automatically on in production
# and off for local development on http://localhost.
# COOKIE_SECURE=true

# The first super admin is not set here: on the very first start the sign-in page asks for their name, email and
# password ("Create the first super admin"). All other accounts are made in the app by the super admin.

# AI features (OpenAI). Leave OPENAI_API_KEY empty to keep AI switched off. Create a key at
# platform.openai.com (API keys) and paste it here – never in the code, never in chat.
# FAKE DATA ONLY until the app, and the data agreement with OpenAI, have been reviewed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# For OpenAI's India data-residency project, use the address OpenAI gives for it.
OPENAI_BASE_URL=https://api.openai.com/v1

# Automatic reminders by SMS or WhatsApp (Version 2). Leave REMINDER_PROVIDER empty: reminders then wait in the
# outbox (Calendar → Reminders) for staff to send by hand. To send automatically through Twilio, set
# REMINDER_PROVIDER=twilio and paste the keys from twilio.com here – never in the code, never in chat.
# In India, SMS needs DLT registration of the sender and the message wording; WhatsApp needs approved templates.
# FAKE DATA ONLY until the app has been reviewed.
REMINDER_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Sending a prescription to the patient on WhatsApp in one click, from the hospital's own WhatsApp Business number
# (Meta's WhatsApp Business Platform). Leave WHATSAPP_MODE empty to keep it off. WHATSAPP_MODE=practice pretends to
# send – nothing leaves this computer – to try the screens. WHATSAPP_MODE=live sends for real: paste the phone number
# id and the access token from Meta (business.facebook.com → WhatsApp → API setup) here – never in the code, never in
# chat – and the name of the message template Meta approved (a DOCUMENT header and a body with one variable, the
# hospital's name). ⚠️ In live mode the PDF goes through Meta's servers. FAKE DATA ONLY until the app has been reviewed.
WHATSAPP_MODE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=perinexa_document
WHATSAPP_TEMPLATE_LANG=en
# The hour (hospital time) from which the next day's appointment reminders go out – and, since 4 Oct 2026, the two
# general messages ("a check-up or test is due", "we missed you"). Nothing is sent before this hour.
REMINDER_SEND_HOUR=10
# The hour (hospital time) from which the two general messages no longer go out that day (19 = none from 19:00 until
# the next morning). They are not tied to a day, so they can wait; appointment messages are not affected.
REMINDER_LAST_HOUR=19

# ABDM linking (ABHA, milestone M1). Leave ABDM_MODE=practice to try the screens with a built-in stand-in (no
# connection to ABDM). With sandbox credentials from sandbox.abdm.gov.in set ABDM_MODE=sandbox and paste the client ID
# and secret here – never in the code, never in chat. 'production' only after ABDM's certification.
ABDM_MODE=practice
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# Sharing her records through her ABHA (milestone M2) and fetching her records from other hospitals (milestone M3):
# Perinexa's public HTTPS address once it is on the internet, e.g. https://perinexa.example.in (no path). ABDM then
# calls https://<that address>/api/abdm/public/… – register that "bridge URL" with ABDM (Hospital admin → ABDM lists
# the addresses); other hospitals send her records to …/api/abdm/public/api/v3/hiu/data/push/<HIU ID>. Leave empty
# while Perinexa runs on this computer.
ABDM_PUBLIC_URL=
# The client ID in the tokens ABDM's gateway signs its own calls with. Perinexa accepts a call from ABDM only with
# this client ID (or the gateway role), so another hospital's ABDM token is refused. Leave it as "gateway" unless the
# sandbox shows another value (Hospital admin → ABDM, checklist).
ABDM_GATEWAY_CLIENT_ID=gateway
