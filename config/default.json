{
  "app": {
    "name": "Perinexa1",
    "tagline": "Hospital care platform",
    "timezone": "Asia/Kolkata",
    "utcOffset": "+05:30"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 5000,
    "apiPrefix": "/api",
    "jsonLimit": "100kb",
    "trustProxy": false
  },
  "client": {
    "port": 5174,
    "url": "http://localhost:5174"
  },
  "database": {
    "uri": "mongodb://127.0.0.1:27017/perinexa1",
    "autoIndex": true,
    "slowQueryMs": 100,
    "logAllQueries": false
  },
  "auth": {
    "jwtSecret": "",
    "cookieName": "p1_session",
    "cookieSecure": false,
    "sessionTimeoutMinutes": 30,
    "bcryptRounds": 12,
    "password": {
      "minLength": 8,
      "maxLength": 128,
      "requireUppercase": true,
      "requireLowercase": true,
      "requireNumber": true,
      "requireSpecial": true
    },
    "temporaryPassword": {
      "groups": 3,
      "groupLength": 4,
      "alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789"
    }
  },
  "rateLimit": {
    "login": { "windowMinutes": 15, "max": 10 },
    "api": { "windowMinutes": 1, "max": 300 }
  },
  "pagination": {
    "defaultLimit": 10,
    "limitOptions": [10, 25, 50, 100],
    "maxLimit": 100
  },
  "roles": [
    { "key": "admin", "label": "Hospital admin" },
    { "key": "doctor", "label": "Doctor" },
    { "key": "rmo", "label": "RMO" },
    { "key": "nurse", "label": "Nurse" },
    { "key": "receptionist", "label": "Receptionist" },
    { "key": "lab", "label": "Lab staff" },
    { "key": "pharmacist", "label": "Pharmacist" },
    { "key": "billing", "label": "Billing" }
  ],
  "adminRole": "admin",
  "access": {
    "patients": ["doctor", "rmo", "nurse", "receptionist", "lab", "pharmacist", "billing"],
    "registerPatients": ["doctor", "rmo", "receptionist"],
    "registrationMenu": ["receptionist"],
    "admitPatients": ["doctor", "rmo", "receptionist"],
    "patientDocuments": ["doctor", "rmo", "nurse", "receptionist"],
    "dischargeCards": ["doctor", "rmo", "nurse", "receptionist"],
    "patientsAllRecords": ["rmo"],
    "patientsClinical": ["doctor", "rmo", "nurse"],
    "patientsContact": ["doctor", "rmo", "nurse", "receptionist", "pharmacist", "billing"],
    "billing": ["receptionist", "billing", "admin"],
    "priceListEdit": ["admin", "billing"],
    "billingReports": ["admin", "billing"],
    "billingAdmin": ["admin"],
    "pharmacy": ["pharmacist", "admin"],
    "pharmacyCounter": ["pharmacist"],
    "pharmacyAdmin": ["admin"],
    "analytics": ["doctor", "admin"],
    "analyticsExact": ["doctor"],
    "appointments": ["receptionist", "doctor", "rmo", "nurse"],
    "bookAppointments": ["receptionist", "doctor"],
    "calendar": ["doctor", "rmo", "receptionist"],
    "calendarClinical": ["doctor", "rmo"],
    "lab": ["lab", "doctor", "rmo", "nurse"],
    "labOrder": ["doctor", "rmo"],
    "labReport": ["lab"],
    "labReview": ["doctor", "rmo"],
    "library": ["doctor", "rmo", "nurse"],
    "libraryEdit": ["doctor", "rmo"],
    "libraryApprove": ["doctor"],
    "superAdminInHospitals": true,
    "superAdminPatientAccess": true
  },
  "masterData": {
    "types": [
      { "key": "department", "label": "Departments", "singular": "Department" },
      { "key": "speciality", "label": "Specialities", "singular": "Speciality" }
    ],
    "hospitalDepartmentType": "department"
  },
  "dashboard": {
    "recentActivityCount": 8,
    "topHospitalsCount": 5
  },
  "prescriberRoles": ["doctor", "rmo"],
  "languages": [
    { "key": "mr", "label": "Marathi" },
    { "key": "hi", "label": "Hindi" }
  ],
  "opd": {
    "doctorRole": "doctor",
    "slotMinutes": 10,
    "defaultSessions": {
      "days": [1, 2, 3, 4, 5, 6],
      "sessions": [{ "from": "10:00", "to": "14:00" }, { "from": "17:00", "to": "20:00" }]
    },
    "maxSessionsPerDay": 4,
    "maxLeavePeriods": 50,
    "visitTypes": [
      { "key": "new", "label": "New patient", "defaultMinutes": 20 },
      { "key": "follow_up", "label": "Follow-up", "defaultMinutes": 10 },
      { "key": "scan", "label": "Scan", "defaultMinutes": 20 },
      { "key": "other", "label": "Other", "defaultMinutes": 10 }
    ]
  },
  "appointments": {
    "maxDaysAhead": 366,
    "reminderDaysAhead": 1,
