{
  "name": "perinexa",
  "private": true,
  "description": "Perinexa – medical web app (MERN). Sample data only.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "predev": "node scripts/db.mjs start",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "seed": "node scripts/db.mjs start && npm run seed -w server",
    "pretest": "node scripts/db.mjs start",
    "test": "npm test -w server && npm test -w client",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "export:hospital": "node scripts/db.mjs start && node server/scripts/export-hospital.js",
    "fix:gst-rates": "node scripts/db.mjs start && node server/scripts/fix-gst-rates.js",
    "load:lab-rates": "node scripts/db.mjs start && node server/scripts/load-lab-rates.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
